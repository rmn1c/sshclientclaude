<UserControl x:Class="SshClient.Controls.CommandTipsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0d1117">

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Padding="12,10" Background="#161b22"
                BorderBrush="#21262d" BorderThickness="0,0,0,1">
            <DockPanel>
                <TextBlock Text="Command Tips" Foreground="#00d9ff"
                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBox x:Name="SearchBox" DockPanel.Dock="Right"
                         Width="130" Height="26" Margin="8,0,0,0"
                         Background="#21262d" Foreground="#c9d1d9"
                         BorderBrush="#30363d" BorderThickness="1"
                         Padding="6,3" FontSize="12"
                         Text="" TextChanged="SearchBox_TextChanged"
                         VerticalAlignment="Center">
                    <TextBox.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </TextBox.Resources>
                </TextBox>
                <TextBlock Text="🔍" DockPanel.Dock="Right"
                           Foreground="#8b949e" VerticalAlignment="Center" Margin="0,0,4,0"/>
            </DockPanel>
        </Border>

        <!-- Categories -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Resources>
                <Style TargetType="ScrollBar">
                    <Setter Property="Width" Value="4"/>
                    <Setter Property="Background" Value="Transparent"/>
                </Style>
            </ScrollViewer.Resources>
            <ItemsControl x:Name="CategoriesPanel" Margin="0,4">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Expander x:Name="CategoryExpander"
                                  IsExpanded="True"
                                  Margin="0,2">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal" Margin="4,0">
                                    <TextBlock Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Name}" Foreground="#c9d1d9"
                                               FontSize="12" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Expander.Header>
                            <Expander.Style>
                                <Style TargetType="Expander">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="#8b949e"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Expander">
                                                <StackPanel>
                                                    <Border x:Name="HeaderBorder"
                                                            Background="Transparent"
                                                            Padding="8,6"
                                                            Cursor="Hand">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Style.Triggers>
                                                                    <Trigger Property="IsMouseOver" Value="True">
                                                                        <Setter Property="Background" Value="#161b22"/>
                                                                    </Trigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <DockPanel>
                                                            <TextBlock x:Name="Arrow" DockPanel.Dock="Right"
                                                                       Text="▸" Foreground="#484f58"
                                                                       FontSize="10" VerticalAlignment="Center"
                                                                       Margin="0,0,4,0"/>
                                                            <ContentPresenter ContentSource="Header"/>
                                                        </DockPanel>
                                                    </Border>
                                                    <ContentPresenter x:Name="Content" Visibility="Collapsed"/>
                                                </StackPanel>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsExpanded" Value="True">
                                                        <Setter TargetName="Content" Property="Visibility" Value="Visible"/>
                                                        <Setter TargetName="Arrow" Property="Text" Value="▾"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Expander.Style>

                            <!-- Tips list -->
                            <ItemsControl ItemsSource="{Binding Tips}" Margin="8,0,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="TipRow" Padding="8,5"
                                                Margin="0,1" Background="Transparent"
                                                Cursor="Hand">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Style.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Background" Value="#161b22"/>
                                                        </Trigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel>
                                                <!-- Copy button -->
                                                <Button x:Name="CopyBtn"
                                                        DockPanel.Dock="Right"
                                                        Content="⎘" Width="22" Height="22"
                                                        Padding="0" Margin="4,0,0,0"
                                                        Foreground="#484f58" Background="Transparent"
                                                        BorderThickness="0"
                                                        FontSize="13"
                                                        Click="CopyTip_Click"
                                                        Tag="{Binding Command}"
                                                        ToolTip="Copy to clipboard"
                                                        Visibility="Hidden">
                                                    <Button.Style>
                                                        <Style TargetType="Button">
                                                            <Style.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter Property="Foreground" Value="#00d9ff"/>
                                                                </Trigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Command}"
                                                               Foreground="#00d9ff"
                                                               FontFamily="JetBrains Mono, Cascadia Code, Consolas"
                                                               FontSize="11.5"/>
                                                    <TextBlock Text="{Binding Description}"
                                                               Foreground="#8b949e"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,1,0,0"/>
                                                </StackPanel>
                                            </DockPanel>
                                            <Border.InputBindings>
                                                <MouseBinding MouseAction="LeftClick"
                                                              Command="{Binding DataContext.SendTipCommand,
                                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              CommandParameter="{Binding Command}"/>
                                            </Border.InputBindings>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <Trigger SourceName="TipRow" Property="IsMouseOver" Value="True">
                                                <Setter TargetName="CopyBtn" Property="Visibility" Value="Visible"/>
                                            </Trigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</UserControl>
