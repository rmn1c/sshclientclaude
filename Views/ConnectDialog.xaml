<Window x:Class="SshClient.Views.ConnectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:SshClient.ViewModels"
        Title="Connect to Host" Height="520" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0d1117"
        WindowStyle="None"
        AllowsTransparency="True">

    <Window.Resources>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#8b949e"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Field" TargetType="TextBox">
            <Setter Property="Background" Value="#161b22"/>
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="CaretBrush" Value="#00d9ff"/>
            <Setter Property="SelectionBrush" Value="#1f3d5c"/>
        </Style>
        <Style x:Key="PasswordField" TargetType="PasswordBox">
            <Setter Property="Background" Value="#161b22"/>
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="BorderBrush" Value="#30363d"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Height" Value="32"/>
        </Style>
        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#00d9ff"/>
            <Setter Property="Foreground" Value="#0d1117"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#33e5ff"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#00b8d9"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryBtn" TargetType="Button">
            <Setter Property="Background" Value="#21262d"/>
            <Setter Property="Foreground" Value="#c9d1d9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#30363d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="10" Background="#0d1117"
            BorderBrush="#30363d" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="#000000" Opacity="0.6" BlurRadius="30" ShadowDepth="0"/>
        </Border.Effect>
        <DockPanel>
            <!-- Custom title bar -->
            <Border DockPanel.Dock="Top" Background="#161b22"
                    CornerRadius="10,10,0,0" Padding="16,10"
                    MouseLeftButtonDown="TitleBar_MouseDown">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" Margin="0,0,-4,0">
                        <Button Content="✕" Width="28" Height="28"
                                Background="Transparent" Foreground="#8b949e"
                                BorderThickness="0" FontSize="12"
                                Click="CloseButton_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="4" Width="28" Height="28">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="Background" Value="#da3633"/>
                                                        <Setter Property="Foreground" Value="White"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                    <TextBlock Text="New Connection" Foreground="#c9d1d9"
                               FontSize="13" FontWeight="SemiBold"
                               VerticalAlignment="Center"/>
                </DockPanel>
            </Border>

            <!-- Content -->
            <StackPanel Margin="24,16">

                <!-- Saved sessions -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="Saved Sessions"/>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ComboBox x:Name="SavedSessionsBox"
                              Background="#161b22" Foreground="#c9d1d9"
                              BorderBrush="#30363d" BorderThickness="1"
                              Height="32" FontSize="13"
                              SelectionChanged="SavedSessions_SelectionChanged">
                        <ComboBox.Resources>
                            <Style TargetType="ComboBoxItem">
                                <Setter Property="Background" Value="#161b22"/>
                                <Setter Property="Foreground" Value="#c9d1d9"/>
                                <Setter Property="Padding" Value="8,4"/>
                            </Style>
                        </ComboBox.Resources>
                    </ComboBox>
                    <Button Grid.Column="1" Content="✕" Width="32" Height="32" Margin="4,0,0,0"
                            Style="{StaticResource SecondaryBtn}" Padding="0"
                            Click="DeleteSession_Click" ToolTip="Remove saved session"/>
                </Grid>

                <!-- Host and Port -->
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Host / IP"/>
                        <TextBox x:Name="HostBox" Style="{StaticResource Field}" Margin="0,0,8,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="Port"/>
                        <TextBox x:Name="PortBox" Style="{StaticResource Field}" Text="22"/>
                    </StackPanel>
                </Grid>

                <!-- Username -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="Username"/>
                <TextBox x:Name="UsernameBox" Style="{StaticResource Field}" Margin="0,0,0,12"/>

                <!-- Auth type toggle -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="Authentication"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <RadioButton x:Name="PasswordRadio" Content="Password"
                                 Foreground="#c9d1d9" FontSize="12" Margin="0,0,16,0"
                                 IsChecked="True" Checked="Auth_Changed"/>
                    <RadioButton x:Name="KeyRadio" Content="Private Key"
                                 Foreground="#c9d1d9" FontSize="12"
                                 Checked="Auth_Changed"/>
                </StackPanel>

                <!-- Password -->
                <StackPanel x:Name="PasswordPanel" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Password"/>
                    <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordField}"/>
                </StackPanel>

                <!-- Key path -->
                <StackPanel x:Name="KeyPanel" Visibility="Collapsed" Margin="0,0,0,12">
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Private Key File"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="KeyPathBox" Style="{StaticResource Field}" Margin="0,0,8,0"/>
                        <Button Grid.Column="1" Content="Browse" Style="{StaticResource SecondaryBtn}"
                                Click="BrowseKey_Click"/>
                    </Grid>
                    <TextBlock Style="{StaticResource FieldLabel}" Text="Passphrase (optional)" Margin="0,8,0,4"/>
                    <PasswordBox x:Name="PassphraseBox" Style="{StaticResource PasswordField}"/>
                </StackPanel>

                <!-- Remember me -->
                <CheckBox x:Name="RememberCheck" Content="Remember credentials"
                          Foreground="#8b949e" FontSize="12"
                          IsChecked="True" Margin="0,0,0,20"/>

                <!-- Profile name -->
                <TextBlock Style="{StaticResource FieldLabel}" Text="Session Name (optional)"/>
                <TextBox x:Name="ProfileNameBox" Style="{StaticResource Field}"
                         Margin="0,0,0,24" Text=""/>

                <!-- Buttons -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ErrorLabel" Foreground="#f85149"
                               FontSize="12" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Cancel" Style="{StaticResource SecondaryBtn}"
                            Margin="0,0,8,0" Click="Cancel_Click"/>
                    <Button Grid.Column="2" Content="Connect" Style="{StaticResource PrimaryBtn}"
                            IsDefault="True" Click="Connect_Click"/>
                </Grid>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>
