<Window x:Class="SshClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:ctrl="clr-namespace:SshClient.Controls"
        xmlns:conv="clr-namespace:SshClient.Converters"
        xmlns:svc="clr-namespace:SshClient.Services"
        Title="SSH Client" MinWidth="900" MinHeight="600"
        Width="1280" Height="780"
        Background="#0D1117"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <conv:BoolToVisibleConverter x:Key="BoolToVisible"/>
        <conv:BoolToCollapsedConverter x:Key="BoolToCollapsed"/>
        <conv:StringToVisibleConverter x:Key="StringToVisible"/>
        <conv:StateToColorConverter x:Key="StateToColor"/>
        <conv:StateToLabelConverter x:Key="StateToLabel"/>
    </Window.Resources>

    <!-- WindowChrome for native resize/snap while keeping custom chrome -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"/>
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder"
            Background="#0D1117"
            BorderBrush="#21262D"
            BorderThickness="1">

        <DockPanel>

            <!-- ════════════════════════════════════
                 TITLE BAR
            ════════════════════════════════════ -->
            <Border DockPanel.Dock="Top"
                    Background="#161B22"
                    BorderBrush="#21262D"
                    BorderThickness="0,0,0,1"
                    Height="42"
                    MouseLeftButtonDown="TitleBar_MouseDown">

                <DockPanel Margin="0,0,4,0">

                    <!-- Window controls (right side) -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                Margin="0,0,4,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Content="─" Style="{StaticResource WinMinBtn}"
                                FontSize="14" Padding="0,-4,0,0"
                                Click="MinimizeButton_Click"/>
                        <Button x:Name="MaxRestoreBtn" Content="□"
                                Style="{StaticResource WinMinBtn}"
                                FontSize="12"
                                Click="MaximizeButton_Click"/>
                        <Button Content="✕" Style="{StaticResource WinCloseBtn}"
                                FontSize="12"
                                Click="CloseButton_Click"/>
                    </StackPanel>

                    <!-- App icon + title -->
                    <StackPanel Orientation="Horizontal" Margin="14,0" VerticalAlignment="Center">
                        <Viewbox Width="18" Height="18" Margin="0,0,8,0">
                            <Canvas Width="24" Height="24">
                                <Ellipse Width="24" Height="24" Fill="#00D9FF" Opacity="0.15"/>
                                <TextBlock Text="⌨" FontSize="14" Canvas.Left="4" Canvas.Top="3"
                                           Foreground="#00D9FF"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="SSH Client" Foreground="#C9D1D9"
                                   FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Quick connect bar -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Margin="0">

                        <TextBox x:Name="HostInput"
                                 Style="{StaticResource DarkInput}"
                                 Width="200" Height="28"
                                 Margin="0,0,6,0"
                                 Text="{Binding QuickHost, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Host / IP"
                                 KeyDown="Input_KeyDown">
                            <TextBox.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </TextBox.Resources>
                        </TextBox>

                        <TextBox x:Name="PortInput"
                                 Style="{StaticResource DarkInput}"
                                 Width="60" Height="28"
                                 Margin="0,0,6,0"
                                 Text="{Binding QuickPort, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="Input_KeyDown"/>

                        <TextBox x:Name="UserInput"
                                 Style="{StaticResource DarkInput}"
                                 Width="130" Height="28"
                                 Margin="0,0,8,0"
                                 Text="{Binding QuickUsername, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="Input_KeyDown"/>

                        <!-- Connect / Disconnect button -->
                        <Button Height="28" Padding="14,0"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                Click="ConnectBtn_Click">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource AccentButton}">
                                    <Setter Property="Content" Value="Connect"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                            <Setter Property="Content" Value="Disconnect"/>
                                            <Setter Property="Background" Value="#3D1010"/>
                                            <Setter Property="Foreground" Value="#F85149"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ConnectionState}"
                                                     Value="{x:Static svc:ConnectionState.Connecting}">
                                            <Setter Property="Content" Value="…"/>
                                            <Setter Property="IsEnabled" Value="False"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ════════════════════════════════════
                 STATUS BAR
            ════════════════════════════════════ -->
            <Border DockPanel.Dock="Bottom"
                    Background="#0D1117"
                    BorderBrush="#21262D"
                    BorderThickness="0,1,0,0"
                    Height="28" Padding="12,0">
                <DockPanel>
                    <!-- Right info -->
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="{Binding EncodingIndicator}"
                                   Foreground="#484F58" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <TextBlock Text="{Binding SessionDuration}"
                                   Foreground="#484F58" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,16,0"/>
                        <!-- Sidebar toggle -->
                        <Button Content="⊞" Style="{StaticResource IconButton}"
                                FontSize="14" Foreground="#484F58"
                                ToolTip="Toggle sidebar"
                                Click="ToggleSidebar_Click"/>
                    </StackPanel>

                    <!-- Left: status + directory -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,6,0"
                                 Fill="{Binding ConnectionState, Converter={StaticResource StateToColor}}"/>
                        <TextBlock Text="{Binding StatusText}"
                                   Foreground="#8B949E" FontSize="11"
                                   VerticalAlignment="Center"/>
                        <TextBlock Text=" — " Foreground="#484F58" FontSize="11"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisible}}"/>
                        <TextBlock Text="{Binding CurrentDirectory}"
                                   Foreground="#00D9FF" FontSize="11"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisible}}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ════════════════════════════════════
                 MAIN CONTENT AREA
            ════════════════════════════════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition x:Name="SidebarCol" Width="260"/>
                </Grid.ColumnDefinitions>

                <!-- Terminal pane -->
                <Border Grid.Column="0"
                        Background="#0D1117"
                        BorderBrush="#21262D"
                        BorderThickness="0,0,1,0">
                    <Grid>
                        <!-- Disconnected overlay -->
                        <Border x:Name="DisconnectedOverlay"
                                Background="#CC0D1117"
                                Visibility="{Binding IsDisconnected, Converter={StaticResource BoolToVisible}}"
                                Panel.ZIndex="10">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="⌨" FontSize="48" HorizontalAlignment="Center"
                                           Foreground="#21262D"/>
                                <TextBlock Text="Not Connected" Foreground="#484F58"
                                           FontSize="18" HorizontalAlignment="Center"
                                           Margin="0,12,0,6"/>
                                <TextBlock Text="Enter a host above and click Connect"
                                           Foreground="#30363D" FontSize="13"
                                           HorizontalAlignment="Center"/>

                                <!-- Error message -->
                                <Border Visibility="{Binding ErrorMessage, Converter={StaticResource StringToVisible}}"
                                        Background="#3D1010" CornerRadius="6"
                                        Padding="16,10" Margin="0,20,0,0"
                                        MaxWidth="400">
                                    <TextBlock Text="{Binding ErrorMessage}"
                                               Foreground="#F85149" FontSize="12"
                                               TextWrapping="Wrap" TextAlignment="Center"/>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- Actual terminal -->
                        <ctrl:TerminalControl x:Name="Terminal"
                                              FontSize="{Binding TerminalFontSize}"
                                              Margin="4,4,4,4"
                                              KeyDown="Terminal_KeyDown"/>
                    </Grid>
                </Border>

                <!-- ============================================================
                     RIGHT SIDEBAR — Command Tips
                ============================================================ -->
                <Border Grid.Column="1"
                        Background="#0D1117"
                        x:Name="SidebarPanel"
                        Visibility="{Binding IsSidebarVisible, Converter={StaticResource BoolToVisible}}">
                    <ctrl:CommandTipsPanel x:Name="TipsPanel"/>
                </Border>
            </Grid>
        </DockPanel>
    </Border>
</Window>
